# Specifieke regel voor index.html: nooit cachen.
# Vite genereert content-hashed JS/CSS-bundles (bijv. main-Abc123.js).
# De browser vindt die bestanden via index.html. Als index.html gecached is,
# laadt de browser na een deploy de oude HTML → oude bundle-hash → oude code.
# no-cache dwingt de browser (en Cloudflare) altijd de server te raadplegen.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*
  # A13: Content Security Policy
  # Digipot communiceert alleen met Supabase (REST + Realtime WebSocket), Sentry en PostHog.
  #
  #   default-src 'self'          — alle bronnen standaard beperkt tot eigen origin
  #   script-src  'self'          — alleen eigen scripts; geen eval, geen inline
  #   style-src   'self' 'unsafe-inline'
  #                               — inline stijlen nodig voor CSS custom properties
  #                                 die React runtime injecteert (--toast-duur e.d.)
  #   connect-src                 — Supabase REST, Realtime WebSocket, Sentry (US + EU), PostHog (EU)
  #   img-src     'self' data:    — data: voor favicon.svg en hero.png
  #   font-src    'self'          — geen externe fonts
  #   object-src  'none'          — nooit plugins (Flash, PDF-embed e.d.)
  #   frame-ancestors 'none'      — clickjacking preventie
  #   base-uri    'self'          — voorkomt base-tag injection
  #   form-action 'self'          — voorkomt formulier-exfiltratie naar externe origins
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://eu.i.posthog.com; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
